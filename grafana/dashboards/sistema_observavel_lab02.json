{
  "title": "Sistema Observavel — Lab 02 (Aulas 01 a 04)",
  "uid": "lab02-sistema",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Execucoes Registradas",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pipeline_runs_total)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Deploys em Prod com Gate (%)",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(deploy_total{env=\"prod\",gate_executed=\"true\"}) / sum(deploy_total{env=\"prod\"})"
        }
      ]
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Findings Criticos por Gate",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(gate_findings) by (gate, severity)"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latencia p95 (com Exemplars)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(pipeline_duration_seconds_bucket[5m])) by (le))",
          "exemplar": true
        }
      ]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Logs Estruturados Recentes (Loki)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"ci-pipeline\"}"
        }
      ]
    }
  ]
}
